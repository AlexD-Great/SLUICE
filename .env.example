# ---------------------------------------------------------------------------
# Sluice — Filecoin Calibration testnet only.
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Sluice's signing wallet ------------------------------------------------
# This is the OPERATOR key. It does not hold user funds — users keep their own
# USDFC in their own Filecoin Pay accounts and grant this address bounded
# operator rights on-chain. It needs tFIL for gas, and nothing else.
#   tFIL faucet: https://faucet.calibnet.chainsafe-fil.io
SLUICE_WALLET_PRIVATE_KEY=0x

# Optional. Defaults to the public Glif gateway; swap for a dedicated RPC if
# you hit rate limits during a demo.
SLUICE_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# --- Spend guardrails -------------------------------------------------------
# Fallback per-request cap in whole USDFC, used when a key names none.
# This is the software gate; the on-chain operator allowance is the hard one.
SLUICE_DEFAULT_CAP_USDFC=1

# How long a held request waits for its owner before expiring, in minutes.
SLUICE_APPROVAL_TTL_MINUTES=60

# --- Optional: shared-wallet override ---------------------------------------
# Normally the account whose funds are at stake is the only one who can approve
# its own held payments, and these stay empty. Set them only if one team runs
# the gateway on a shared wallet and needs named approvers.
SLUICE_OPERATOR_UIDS=
SLUICE_OPERATOR_EMAILS=

# --- Firebase (server, Admin SDK) -------------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private
# key. Paste the whole JSON on one line, or base64-encode it if your host
# mangles newlines (Vercel's env UI does).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase (browser) -----------------------------------------------------
# Firebase console > Project settings > Your apps > Web app config.
# Public values; access is governed by firestore.rules.
# Enable Google sign-in under Authentication > Sign-in method, and add your
# deployment domain under Authentication > Settings > Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- WalletConnect ----------------------------------------------------------
# Project id from https://cloud.reown.com. Without one, browser-extension
# wallets still work; only the mobile QR-code flow is unavailable.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

rules_version = '2';

// Sluice Firestore security rules.
//
// The server writes with the Admin SDK, which bypasses everything here. These
// rules therefore govern one thing only: what a browser holding the public
// Firebase config can do. The answer is "read your own data, write nothing".
//
// Every state change to a payment goes through an authenticated API route so it
// is gated, audited and executed on-chain. If a browser could write to
// `authorizations`, the agent being gated could approve its own payment — which
// would defeat the entire product.
//
// This is multi-tenant: one user's payments must never be visible to another.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Account records. A user may read their own; nobody writes from a browser,
    // because `walletAddress` and `operatorApproval` are only ever set after a
    // signature check or an on-chain read.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Payments. Readable only by the account whose funds are at stake.
    //
    // Firestore evaluates `read` on a query against the query itself, so a
    // listener must filter by ownerUid or it is rejected outright — see
    // useAuthorizations.
    match /authorizations/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Proof-check feed. Verification is unauthenticated and reveals only what is
    // already public on-chain, so any signed-in user may read the feed.
    match /verifications/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // PieceCID -> data set mapping. Public chain data.
    match /pieces/{pieceCid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // API keys are stored hashed, but the label, cap and owner still describe a
    // user's security posture. Served through the API, never read directly.
    match /apiKeys/{id} {
      allow read, write: if false;
    }

    // Wallet-link challenges. Handing these to a browser would help nobody but
    // an attacker mid-replay.
    match /walletNonces/{uid} {
      allow read, write: if false;
    }

    // Append-only audit trail, served through the API.
    match /auditLog/{id} {
      allow read, write: if false;
    }

    // Bytes of held uploads. A browser has no reason to pull these back down.
    match /payloads/{id} {
      allow read, write: if false;
    }

    // Internal machinery: the wallet mutex and idempotency claims.
    match /locks/{id} {
      allow read, write: if false;
    }

    match /idempotency/{id} {
      allow read, write: if false;
    }

    // Anything not named above is denied. Kept explicit so a new collection
    // added later fails closed rather than inheriting a permissive default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
